{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teman-rara",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Dipakai OpenNext untuk on-demand revalidation (revalidatePath) via
  // self-fetch, bukan lewat KV/queue eksternal.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "teman-rara" }
  ],
  // Variabel non-rahasia diinjeksi saat deploy (lihat .github/workflows/deploy.yml,
  // sumbernya GitHub Variables). Jangan taruh nilai di file ini: repo bisa publik.
  // keep_vars mencegah deploy lokal menghapus variabel yang sudah terpasang.
  "keep_vars": true,
  // Workers Logs: console.error dari server action dan cron bisa dicari di dashboard.
  "observability": { "enabled": true }
}
